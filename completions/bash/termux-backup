_termux_backup() {
    local cur
    cur="${COMP_WORDS[COMP_CWORD]}"
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "-h --help -f --force --ignore-read-failure" -- "$cur") )
        return 0
    fi
    _filedir 2>/dev/null || COMPREPLY=( $(compgen -f -- "$cur") )
}
complete -F _termux_backup termux-backup

#compdef chsh

local -a known_shells=(
    ash
    bash
    beanshell
    bsh
    cicada
    csh
    dash
    eltclsh
    elvish
    etsh
    fish
    hilbish
    ksh
    loksh
    mksh
    nu
    osh
    pwsh
    rc
    sh
    tcsh
    tsh
    xonsh
    ysh
    zsh
)

local sh
local -a installed_shells=()
for sh in "${known_shells[@]}"; do
    (( $+commands[$sh] )) && installed_shells+=("$sh")
done

_arguments \
    '(-h --help)'{-h,--help}'[Show usage information]' \
    "-s[Change login shell]:shell:($installed_shells)"

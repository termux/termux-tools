#!@TERMUX_PREFIX@/bin/bash
##
## Termux script for restoring $HOME and/or $PREFIX from a backup archive.
## For backup script, see "termux-backup".
##

set -e -u

export PREFIX="@TERMUX_PREFIX@"
export HOME="@TERMUX_HOME@"
ROOTFS="@TERMUX_BASE_DIR@"

# Tar member names for $HOME and $PREFIX, relative to $ROOTFS.
HOME_MEMBER=".${HOME#"${ROOTFS%/}"}"
PREFIX_MEMBER=".${PREFIX#"${ROOTFS%/}"}"

# $HOME may be placed inside $PREFIX in layouts without 'usr' merge,
# e.g. when $PREFIX is same as $ROOTFS.
HOME_IN_PREFIX=false
if [[ "$HOME" == "$PREFIX"/* ]]; then
	HOME_IN_PREFIX=true
fi

msg() {
	echo "$*" >&2
}

show_usage() {
	msg
	msg "Usage: termux-restore [options] <input file>"
	msg
	msg "Script for restoring Termux directories from a TAR archive created"
	msg "by 'termux-backup'. By default, only \$PREFIX is restored."
	msg
	msg "Restoring erases all files in the target directory that are not"
	msg "present in the archive. Pass --no-clean to skip this behavior."
	msg
	msg "Options:"
	msg
	msg " -h, --help     Show this information."
	msg " --home         Restore \$HOME from backup."
	msg " --packages     Restore \$PREFIX from backup."
	msg " --no-clean     Do not erase target directories before restoring."
	msg
	msg "If neither --home nor --packages is specified, only \$PREFIX is restored."
	msg
}

if [ "$(id -u)" = "0" ]; then
	msg "This script should not be used as root."
	exit 1
fi

BACKUP_FILE_PATH=
RESTORE_HOME=false
RESTORE_PACKAGES=false
RECURSIVE_UNLINK=true

while (($# >= 1)); do
	case "$1" in
		--) shift 1; break;;
		-\?|-h|--help|--usage)
			show_usage
			exit 0
			;;
		--home)
			RESTORE_HOME=true
			;;
		--packages)
			RESTORE_PACKAGES=true
			;;
		--no-clean)
			RECURSIVE_UNLINK=false
			;;
		*)
			if [ -z "$1" ]; then
				msg
				msg "[!] Input file path should not be an empty string."
				show_usage
				exit 1
			fi

			if [[ $1 =~ ^-.+ ]]; then
				msg
				msg "[!] Unknown option passed: ${1}"
				show_usage
				exit 1
			fi

			if [ -z "$BACKUP_FILE_PATH" ]; then
				BACKUP_FILE_PATH=$1
			else
				msg
				msg "[!] Redundant input file path specified: ${1}"
				show_usage
				exit 1
			fi
			;;
	esac
	shift 1
done

if [ -z "$BACKUP_FILE_PATH" ]; then
	msg
	msg "[!] No backup file path specified."
	show_usage
	exit 1
fi

if [ ! -e "$BACKUP_FILE_PATH" ]; then
	msg "[!] $BACKUP_FILE_PATH: file does not exist."
	exit 1
fi

if [ ! -f "$BACKUP_FILE_PATH" ]; then
	msg "[!] $BACKUP_FILE_PATH: path is not a regular file."
	exit 1
fi

# Default: restore packages only.
if ! $RESTORE_HOME && ! $RESTORE_PACKAGES; then
	RESTORE_PACKAGES=true
fi

msg "Fixing read-write access to files where necessary..."
RESTORE_DIRS=()
TAR_EXCLUDE_OPTS=
if $RESTORE_HOME; then
	if [ -d "$HOME" ]; then
		find "$HOME" -type d,f -print0 | xargs -0 -r chmod u+rwX
	fi
	RESTORE_DIRS+=("$HOME_MEMBER")
fi
if $RESTORE_PACKAGES; then
	if [ -d "$PREFIX" ]; then
		find "$PREFIX" -path "$HOME" -prune -o -type d,f -print0 | xargs -0 -r chmod u+rwX
	fi
	RESTORE_DIRS+=("$PREFIX_MEMBER")

	# When $HOME is inside $PREFIX, archive made by 'termux-backup' holds
	# contents of $PREFIX as separate members rather than $PREFIX itself,
	# so --recursive-unlink cannot wipe $HOME. Additionally leave $HOME
	# members alone if they are in archive but were not requested.
	if $HOME_IN_PREFIX && ! $RESTORE_HOME; then
		TAR_EXCLUDE_OPTS="--anchored --no-wildcards --exclude=$HOME_MEMBER"
	fi
fi

TAR_UNLINK_OPT=
if $RECURSIVE_UNLINK; then
	TAR_UNLINK_OPT="--recursive-unlink"
fi

msg "Restoring: ${RESTORE_DIRS[*]}"
tar -x -C "$ROOTFS" -f "$BACKUP_FILE_PATH" \
	$TAR_UNLINK_OPT $TAR_EXCLUDE_OPTS --preserve-permissions \
	"${RESTORE_DIRS[@]}"
